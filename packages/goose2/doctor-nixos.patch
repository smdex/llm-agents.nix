+/// Resolve a login shell from explicit environment values.
+pub fn login_shell_from(shell_env: Option<&str>, path_env: Option<&str>) -> Option<PathBuf> {
+    if let Some(shell) = shell_env
+        .map(PathBuf::from)
+        .filter(|path| path.is_file())
+    {
+        return Some(shell);
+    }
+
+    for name in ["zsh", "bash", "sh"] {
+        if let Some(shell) = resolve_on_path(name, path_env) {
+            return Some(shell);
+        }
+    }
+
+    ["/bin/zsh", "/bin/bash", "/bin/sh"]
+        .into_iter()
+        .map(PathBuf::from)
+        .find(|path| path.is_file())
+}
+
+/// Resolve a login shell from the inherited environment.
+pub fn login_shell() -> Option<PathBuf> {
+    login_shell_from(
+        std::env::var("SHELL").ok().as_deref(),
+        std::env::var("PATH").ok().as_deref(),
+    )
+}
