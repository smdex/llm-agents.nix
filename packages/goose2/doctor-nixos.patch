+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::fs;
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    fn temporary_directory(name: &str) -> PathBuf {
+        static NEXT: AtomicU64 = AtomicU64::new(0);
+        let id = NEXT.fetch_add(1, Ordering::Relaxed);
+        std::env::temp_dir().join(format!("doctor-{name}-{}-{id}", std::process::id()))
+    }
+
+    #[test]
+    fn path_only_resolution_does_not_require_an_fhs_shell() {
+        let directory = temporary_directory("path-only");
+        fs::create_dir_all(&directory).unwrap();
+        let binary = directory.join("goose");
+        fs::write(&binary, b"fake executable").unwrap();
+
+        let resolved = resolve_binary_with_env("goose", directory.to_str(), None);
+
+        assert_eq!(resolved.path, Some(binary));
+        assert!(resolved.search_output.contains("strategy 0"));
+        fs::remove_dir_all(directory).unwrap();
+    }
+
+    #[test]
+    fn login_shell_prefers_the_configured_store_path() {
+        let directory = temporary_directory("shell");
+        fs::create_dir_all(&directory).unwrap();
+        let shell = directory.join("bash");
+        fs::write(&shell, b"fake shell").unwrap();
+
+        assert_eq!(login_shell_from(shell.to_str(), None), Some(shell.clone()));
+        assert_eq!(login_shell_from(None, directory.to_str()), Some(shell));
+        fs::remove_dir_all(directory).unwrap();
+    }
+}
